#!/usr/bin/python3 -I
"""Summarize local Claude Code activity from ~/.claude/logs.

  claude-stats [--days N]   default 7

Cost comes from status line snapshots and is a list-price estimate.
"""
import argparse
import glob
import json
import os
import time
from collections import Counter, defaultdict

LOG_DIR = os.environ.get("CLAUDE_LOG_DIR") or os.path.expanduser("~/.claude/logs")


def load(cutoff):
    events = []
    for path in sorted(glob.glob(os.path.join(LOG_DIR, "activity-*.jsonl"))):
        with open(path) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("ts", "")[:10] >= cutoff:
                    events.append(e)
    snaps = []
    for path in glob.glob(os.path.join(LOG_DIR, "sessions", "*.json")):
        try:
            with open(path) as f:
                s = json.load(f)
        except (OSError, ValueError):
            continue
        if s.get("updated", "")[:10] >= cutoff:
            snaps.append(s)
    return events, snaps


def top(counter, n=8, fmt=lambda k, v: f"{k} {v}"):
    return ", ".join(fmt(k, v) for k, v in counter.most_common(n)) or "none"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--days", type=int, default=7)
    days = ap.parse_args().days
    cutoff = time.strftime("%Y-%m-%d", time.localtime(time.time() - (days - 1) * 86400))
    events, snaps = load(cutoff)

    starts = [e for e in events if e["event"] == "SessionStart"]
    per_day = Counter(e["ts"][5:10] for e in starts)
    tools = [e for e in events if e["event"] in ("PostToolUse", "PostToolUseFailure")]
    calls, fails = Counter(e.get("tool") for e in tools), Counter(e.get("tool") for e in tools if not e.get("ok"))
    proj_sessions = Counter(e.get("project") for e in starts)
    proj_calls = Counter(e.get("project") for e in tools)
    guards = Counter(f"{e.get('hook')} {e.get('decision')}" for e in events if e["event"] == "guard")
    reminders = Counter(e.get("hook") for e in events if e["event"] == "reminder")
    backups = Counter(f"{e.get('repo')} {e.get('result')}" for e in events if e["event"] == "memory_autocommit")
    errors = Counter(e.get("hook") for e in events if e["event"] == "hook_error")
    cost = defaultdict(float)
    for s in snaps:
        cost[s.get("project")] += s.get("cost_usd") or 0

    n_fail = sum(fails.values())
    print(f"Claude Code activity, last {days} days (since {cutoff})\n")
    print(f"Sessions:    {len(starts)}  ({', '.join(f'{d} {n}' for d, n in sorted(per_day.items())) or 'none'})")
    print(f"Tool calls:  {len(tools)}, {n_fail} failed ({100 * n_fail / max(len(tools), 1):.1f}%)")
    print(f"Top tools:   {top(calls, fmt=lambda k, v: f'{k} {v}' + (f' ({fails[k]} failed)' if fails[k] else ''))}")
    print(f"Projects:    {top(proj_sessions, fmt=lambda k, v: f'{k} {v} sessions/{proj_calls[k]} calls')}")
    print(f"Guards:      {top(guards, 20)}")
    print(f"Reminders:   {top(reminders)}")
    print(f"Memory:      {top(backups)}")
    print(f"Est. cost:   ${sum(cost.values()):.2f} list price"
          + (f"  ({', '.join(f'{p} ${c:.2f}' for p, c in sorted(cost.items(), key=lambda x: -x[1])[:6])})" if cost else ""))
    if errors:
        print(f"Hook errors: {top(errors)}")


if __name__ == "__main__":
    main()
